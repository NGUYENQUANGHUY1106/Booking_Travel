NODE_ENV=development
API_PORT=3000
API_PREFIX=api
MOBILE_ORIGIN=http://localhost:8081

POSTGRES_DB=booking_travel
POSTGRES_USER=booking_travel
POSTGRES_PASSWORD=booking_travel_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://booking_travel:booking_travel_dev@localhost:5432/booking_travel?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-local-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-local-development-secret

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
# Chỉ bật để xem Admin Dashboard với phiên đăng nhập demo riêng.
EXPO_PUBLIC_ENABLE_ADMIN_DEMO=false
