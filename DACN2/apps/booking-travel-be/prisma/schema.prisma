generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdministrativeLevel {
  COUNTRY
  PROVINCE
  DISTRICT
  COMMUNE
}

enum AdministrativeCatalogMode {
  CURRENT
  LEGACY
}

enum AdministrativeUnitStatus {
  ACTIVE
  INACTIVE
  MERGED
  DISSOLVED
}

enum AdministrativeUnitType {
  COUNTRY
  PROVINCE
  MUNICIPALITY
  CITY
  URBAN_DISTRICT
  RURAL_DISTRICT
  TOWN
  WARD
  COMMUNE
  TOWNSHIP
  SPECIAL_ZONE
  UNKNOWN
}

enum AdministrativeAliasKind {
  FORMER_NAME
  ALTERNATIVE_NAME
  SEARCH_NAME
}

enum AdministrativeTransitionType {
  MERGED_INTO
  SPLIT_INTO
  RENAMED_TO
  PARTIALLY_TRANSFERRED_TO
}

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AddressMode {
  CURRENT
  LEGACY
}

enum UserRole {
  USER
  HOTEL_OWNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
}

enum OwnerApplicationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OwnerDocumentPurpose {
  IDENTITY
  BUSINESS_LICENSE
}

enum PrivateMediaStatus {
  RESERVED
  READY
}

enum UserGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AccommodationPreferenceType {
  HOTEL
  RESORT
  VILLA
  APARTMENT
  HOMESTAY
  HOSTEL
}

enum TravelTripType {
  SOLO
  COUPLE
  FAMILY
  FRIENDS
  BUSINESS
  WELLNESS
}

enum TravelAmenityPreference {
  WIFI
  BREAKFAST
  POOL
  PARKING
  SPA
  GYM
  BEACH
  AIRPORT_SHUTTLE
  PET_FRIENDLY
  FAMILY_ROOM
}

enum TravelAreaPreference {
  BEACHFRONT
  CITY_CENTER
  QUIET
  NEAR_AIRPORT
  NEAR_ATTRACTIONS
  NIGHTLIFE
  LOCAL_CULTURE
  NATURE
}

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum HotelStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum HotelSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum HotelMediaStatus {
  RESERVED
  READY
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum StayReminderKind {
  CHECK_IN_24H
  CHECK_IN_2H
  CHECK_OUT_24H
  CHECK_OUT_2H
}

enum HotelReportReason {
  INCORRECT_INFORMATION
  MISLEADING_IMAGES
  FRAUD
  SAFETY
  OTHER
}

enum HotelReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum BookingPaymentMethod {
  PAY_AT_HOTEL
  SIMULATOR
}

enum PlatformVoucherStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum PlatformDiscountType {
  PERCENT
  FIXED
}

enum VoucherRedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum PaymentMethod {
  PAY_AT_HOTEL
}

enum PaymentStatus {
  PENDING
  PAID
  SUCCESS
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundRequestStatus {
  PENDING_REVIEW
  APPROVED
  PROCESSING
  FAILED
  REJECTED
  COMPLETED
}

enum InvoiceDocumentType {
  BOOKING_SUMMARY
  PAYMENT_RECEIPT
}

model User {
  id                            String                         @id @default(cuid())
  email                         String?                        @unique
  passwordHash                  String
  fullName                      String
  phone                         String?                        @unique
  avatarUrl                     String?
  dateOfBirth                   DateTime?                      @db.Date
  gender                        UserGender?
  nationality                   String?
  address                       String?
  role                          UserRole                       @default(USER)
  status                        UserStatus                     @default(PENDING_VERIFICATION)
  isActive                      Boolean                        @default(false)
  termsAcceptedAt               DateTime?
  emailVerifiedAt               DateTime?
  phoneVerifiedAt               DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  ownedHotels                   Hotel[]                        @relation("HotelOwner")
  bookings                      Booking[]
  payments                      Payment[]
  invoices                      Invoice[]
  adminProfile                  AdminProfile?
  verificationCodes             VerificationCode[]
  authSessions                  AuthSession[]
  adminActions                  AdminUserAudit[]               @relation("AdminAuditActor")
  accountAudits                 AdminUserAudit[]               @relation("AdminAuditTarget")
  ownerApplication              HotelOwnerApplication?
  privateMedia                  PrivateMediaObject[]
  ownerProfile                  HotelOwnerProfile?
  ownerReviews                  OwnerApplicationAudit[]        @relation("OwnerReviewActor")
  ownerAuditTrail               OwnerApplicationAudit[]        @relation("OwnerReviewApplicant")
  ownerNotifications            OwnerApplicationNotification[]
  reviewedOwnerApplications     HotelOwnerApplication[]        @relation("OwnerApplicationReviewer")
  travelPreference              UserPreference?
  hotelRestrictionActions       HotelRestrictionAudit[]        @relation("HotelRestrictionActor")
  hotelRestrictionNotifications HotelRestrictionNotification[] @relation("HotelRestrictionRecipient")
  conversations                 Conversation[]                 @relation("ConversationUser")
  ownerConversations            Conversation[]                 @relation("ConversationOwner")
  sentMessages                  Message[]
  requestedRefunds              RefundRequest[]                @relation("RefundRequester")
  reviewedRefunds               RefundRequest[]                @relation("RefundReviewer")
  stayTransitions               BookingStayTransition[]        @relation("StayTransitionActor")
  wishlists                     Wishlist[]
  hotelReports                  HotelReport[]
  userNotifications            UserNotification[]
  pushDeviceTokens              PushDeviceToken[]
  stayReminders                 StayReminder[]

  @@index([role, isActive])
  @@index([status])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(1000)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushDeviceToken {
  id                String   @id @default(cuid())
  userId            String
  token             String   @unique @db.VarChar(512)
  platform          String   @db.VarChar(20)
  enabled           Boolean  @default(true)
  lastRegisteredAt  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model HotelOwnerApplication {
  id                         String                         @id @default(cuid())
  userId                     String                         @unique
  status                     OwnerApplicationStatus         @default(DRAFT)
  version                    Int                            @default(1)
  revision                   Int                            @default(0)
  businessName               String?
  businessAddress            String?
  representativeName         String?
  businessRegistrationNumber String?
  businessPhone              String?
  accommodationType          AccommodationPreferenceType?
  hotelDescription           String?
  hotelCoverImageUrl         String?
  identityDocumentId         String?                        @unique
  businessLicenseDocumentId  String?                        @unique
  rejectionReason            String?
  approvalNote               String?
  reviewedAt                 DateTime?
  reviewedById               String?
  reviewHistory              Json                           @default("[]")
  submittedAt                DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  user                       User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityDocument           PrivateMediaObject?            @relation("OwnerIdentity", fields: [identityDocumentId], references: [id], onDelete: SetNull)
  businessLicenseDocument    PrivateMediaObject?            @relation("OwnerLicense", fields: [businessLicenseDocumentId], references: [id], onDelete: SetNull)
  reviewedBy                 User?                          @relation("OwnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  auditTrail                 OwnerApplicationAudit[]
  notifications              OwnerApplicationNotification[]

  @@index([status, submittedAt])
}

model HotelOwnerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  isActive   Boolean  @default(true)
  verifiedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model OwnerApplicationAudit {
  id            String                 @id @default(cuid())
  applicationId String
  applicantId   String
  actorId       String
  action        String
  oldStatus     OwnerApplicationStatus
  newStatus     OwnerApplicationStatus
  reason        String?                @db.VarChar(500)
  version       Int
  createdAt     DateTime               @default(now())
  application   HotelOwnerApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicant     User                   @relation("OwnerReviewApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  actor         User                   @relation("OwnerReviewActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
}

model OwnerApplicationNotification {
  id            String                @id @default(cuid())
  applicationId String
  userId        String
  version       Int
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime              @default(now())
  application   HotelOwnerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([applicationId, version])
  @@index([userId, createdAt])
}

model PrivateMediaObject {
  id                  String                 @id @default(cuid())
  userId              String
  purpose             OwnerDocumentPurpose
  status              PrivateMediaStatus     @default(RESERVED)
  objectKey           String                 @unique
  mimeType            String
  expectedSize        Int
  verifiedAt          DateTime?
  createdAt           DateTime               @default(now())
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityApplication HotelOwnerApplication? @relation("OwnerIdentity")
  licenseApplication  HotelOwnerApplication? @relation("OwnerLicense")

  @@index([userId, purpose, status])
}

model UserPreference {
  id                 String                        @id @default(cuid())
  userId             String                        @unique
  budgetMin          Int?
  budgetMax          Int?
  currency           String                        @default("VND")
  accommodationTypes AccommodationPreferenceType[] @default([])
  tripTypes          TravelTripType[]              @default([])
  preferredAmenities TravelAmenityPreference[]     @default([])
  preferredAreas     TravelAreaPreference[]        @default([])
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AuthSession {
  id               String    @id
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model AdminUserAudit {
  id           String     @id @default(cuid())
  actorId      String
  targetUserId String
  action       String
  oldStatus    UserStatus
  newStatus    UserStatus
  reason       String     @db.VarChar(500)
  createdAt    DateTime   @default(now())
  actor        User       @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target       User       @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

model VerificationCode {
  id                String                     @id @default(cuid())
  userId            String
  sessionId         String                     @unique
  purpose           VerificationPurpose
  channel           VerificationChannel
  target            String
  codeHash          String
  expiresAt         DateTime
  resendAvailableAt DateTime
  sendCount         Int                        @default(1)
  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  deliveryStatus    VerificationDeliveryStatus @default(QUEUED)
  consumedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([target, purpose, expiresAt])
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Hotel {
  id                 String                                @id @default(cuid())
  ownerId            String
  name               String
  slug               String                                @unique
  description        String?
  addressLine        String?
  city               String?
  province           String?
  district           String?
  ward               String?
  provinceUnitId     String?
  districtUnitId     String?
  wardUnitId         String?
  accommodationType  AccommodationPreferenceType?
  contactEmail       String?
  contactPhone       String?
  checkInTime        String?                               @db.VarChar(5)
  checkOutTime       String?                               @db.VarChar(5)
  profileVersion     Int                                   @default(1)
  restrictionVersion Int                                   @default(0)
  clientDraftId      String?
  latitude           Decimal?                              @db.Decimal(10, 7)
  longitude          Decimal?                              @db.Decimal(10, 7)
  location           Unsupported("geography(Point,4326)")?
  starRating         Int                                   @default(0)
  status             HotelStatus                           @default(DRAFT)
  isVisible          Boolean                               @default(true)
  amenities          String[]                              @default([])
  coverImageUrl      String?
  deletedAt          DateTime?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  owner              User                                  @relation("HotelOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  rooms              Room[]
  bookings           Booking[]
  policy             HotelPolicy?
  media              HotelMedia[]
  amenityLinks       HotelAmenity[]
  submissions        HotelSubmission[]
  restrictionAudits  HotelRestrictionAudit[]
  operationalTasks   HotelBookingOperationalTask[]
  conversations      Conversation[]
  nearbyPlaces       NearbyPlaceCache[]
  favorites          Favorite[]
  reports            HotelReport[]

  @@unique([ownerId, clientDraftId])
  @@index([ownerId, deletedAt])
  @@index([status, city, deletedAt])
}

model NearbyPlaceCache {
  id              String   @id @default(cuid())
  hotelId         String
  provider        String
  providerPlaceId String
  name            String
  address         String?
  category        String
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  distanceMeters  Int
  sourceUrl       String?
  attribution     String
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, provider, providerPlaceId])
  @@index([hotelId, category, distanceMeters])
  @@index([expiresAt])
}

model Wishlist {
  id        String     @id @default(cuid())
  userId    String
  name      String     @db.VarChar(80)
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model Favorite {
  id         String   @id @default(cuid())
  wishlistId String
  hotelId    String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, hotelId])
  @@index([hotelId])
}

model Landmark {
  id             String                                @id
  name           String
  normalizedName String                                @unique
  addressLine    String?
  city           String?
  province       String?
  latitude       Decimal                               @db.Decimal(10, 7)
  longitude      Decimal                               @db.Decimal(10, 7)
  location       Unsupported("geography(Point,4326)")?
  isActive       Boolean                               @default(true)
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  @@index([city, isActive])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  ownerId   String
  hotelId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation("ConversationUser", fields: [userId], references: [id], onDelete: Restrict)
  owner     User      @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  messages  Message[]

  @@unique([userId, hotelId])
  @@index([ownerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model HotelMedia {
  id           String           @id @default(cuid())
  hotelId      String
  roomId       String?
  ownerId      String
  objectKey    String           @unique
  mimeType     String
  expectedSize Int
  status       HotelMediaStatus @default(RESERVED)
  sortOrder    Int              @default(0)
  isCover      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  verifiedAt   DateTime?
  deletedAt    DateTime?
  hotel        Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room         Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([hotelId, status, sortOrder])
  @@index([roomId, status, sortOrder])
  @@index([ownerId, createdAt])
}

model AmenityCatalog {
  id     String         @id
  name   String
  active Boolean        @default(true)
  hotels HotelAmenity[]
}

model HotelAmenity {
  hotelId   String
  amenityId String
  hotel     Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   AmenityCatalog @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([hotelId, amenityId])
}

model HotelSubmission {
  id            String                        @id @default(cuid())
  hotelId       String
  ownerId       String
  version       Int
  snapshot      Json
  status        HotelSubmissionStatus         @default(PENDING)
  reason        String?                       @db.VarChar(1000)
  decidedById   String?
  decidedAt     DateTime?
  submittedAt   DateTime                      @default(now())
  hotel         Hotel                         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  audits        HotelSubmissionAudit[]
  notifications HotelSubmissionNotification[]

  @@unique([hotelId, version])
  @@index([ownerId, submittedAt])
}

model HotelSubmissionAudit {
  id           String          @id @default(cuid())
  submissionId String
  actorId      String
  action       String
  oldStatus    HotelStatus?
  newStatus    HotelStatus?
  hotelId      String
  version      Int
  reason       String?         @db.VarChar(1000)
  requestId    String?         @unique @db.VarChar(80)
  createdAt    DateTime        @default(now())
  submission   HotelSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt])
}

model HotelSubmissionNotification {
  id           String          @id @default(cuid())
  submissionId String
  recipientId  String
  kind         String
  title        String
  body         String
  readAt       DateTime?
  createdAt    DateTime        @default(now())
  submission   HotelSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, recipientId, kind])
  @@index([recipientId, createdAt])
}

model HotelRestrictionAudit {
  id                 String                         @id @default(cuid())
  hotelId            String
  ownerId            String
  actorId            String
  actorRole          UserRole
  action             String
  beforeStatus       HotelStatus
  afterStatus        HotelStatus
  beforeVisible      Boolean
  afterVisible       Boolean
  profileVersion     Int
  restrictionVersion Int
  reason             String                         @db.VarChar(1000)
  evidenceReference  String?                        @db.VarChar(500)
  futureBookingCount Int                            @default(0)
  requestId          String                         @unique @db.VarChar(80)
  createdAt          DateTime                       @default(now())
  hotel              Hotel                          @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  actor              User                           @relation("HotelRestrictionActor", fields: [actorId], references: [id], onDelete: Restrict)
  notifications      HotelRestrictionNotification[]
  operationalTasks   HotelBookingOperationalTask[]

  @@index([hotelId, createdAt])
}

model HotelRestrictionNotification {
  id          String                @id @default(cuid())
  decisionId  String
  recipientId String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime              @default(now())
  decision    HotelRestrictionAudit @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  recipient   User                  @relation("HotelRestrictionRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([decisionId, recipientId])
  @@index([recipientId, createdAt])
}

model HotelBookingOperationalTask {
  id         String                @id @default(cuid())
  decisionId String
  hotelId    String
  bookingId  String
  status     String                @default("OPEN")
  createdAt  DateTime              @default(now())
  resolvedAt DateTime?
  decision   HotelRestrictionAudit @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  hotel      Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  booking    Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([decisionId, bookingId])
  @@index([hotelId, status, createdAt])
}

model HotelPolicy {
  hotelId            String   @id
  cancellationPolicy String?
  refundRules        Json?
  houseRules         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Room {
  id                 String                  @id @default(cuid())
  hotelId            String
  name               String
  type               String
  description        String?
  capacityAdults     Int                     @default(2)
  capacityChildren   Int                     @default(0)
  bedInfo            String
  classCode          String?
  viewCode           String?
  bedConfigurations  Json?
  areaM2             Decimal?                @db.Decimal(7, 2)
  quantity           Int                     @default(1)
  basePrice          Decimal                 @db.Decimal(14, 2)
  pricingVersion     Int                     @default(1)
  currency           String                  @default("VND")
  status             RoomStatus              @default(ACTIVE)
  revision           Int                     @default(1)
  amenities          String[]                @default([])
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  hotel              Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  media              HotelMedia[]
  bookings           Booking[]
  inventoryBlocks    RoomInventoryBlock[]
  inventoryOverrides RoomInventoryOverride[]
  inventoryAudits    RoomInventoryAudit[]
  pricingRules       RoomPricingRule[]
  pricingAudits      RoomPricingAudit[]

  @@index([hotelId, status, deletedAt])
}

model PlatformVoucher {
  id                  String                @id @default(cuid())
  code                String                @unique
  source              String                @default("PLATFORM")
  title               String
  description         String?
  status              PlatformVoucherStatus @default(DRAFT)
  discountType        PlatformDiscountType
  discountValue       Decimal               @db.Decimal(14, 2)
  maxDiscount         Decimal?              @db.Decimal(14, 2)
  minSpend            Decimal               @default(0) @db.Decimal(14, 2)
  minNights           Int                   @default(1)
  currency            String                @default("VND")
  startsAt            DateTime
  endsAt              DateTime
  hotelIds            String[]              @default([])
  eligibleUserIds     String[]              @default([])
  globalLimit         Int
  perUserLimit        Int
  budget              Decimal               @db.Decimal(14, 2)
  reservedCount       Int                   @default(0)
  consumedCount       Int                   @default(0)
  reservedAmount      Decimal               @default(0) @db.Decimal(14, 2)
  consumedAmount      Decimal               @default(0) @db.Decimal(14, 2)
  version             Int                   @default(1)
  createdById         String
  updatedById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  redemptions         VoucherRedemption[]
  audits              PlatformVoucherAudit[]

  @@index([status, startsAt, endsAt])
  @@index([updatedAt, id])
}

model VoucherRedemption {
  id             String                  @id @default(cuid())
  voucherId      String
  bookingId      String                  @unique
  userId         String
  amount         Decimal                 @db.Decimal(14, 2)
  currency       String
  status         VoucherRedemptionStatus @default(RESERVED)
  reservedUntil  DateTime?
  createdAt      DateTime                @default(now())
  consumedAt     DateTime?
  releasedAt     DateTime?
  voucher        PlatformVoucher         @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  booking        Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([voucherId, status, createdAt])
  @@index([voucherId, userId, status])
}

model PlatformVoucherAudit {
  id         String          @id @default(cuid())
  voucherId  String
  actorId    String
  action     String
  reason     String
  before     Json?
  after      Json?
  createdAt  DateTime        @default(now())
  voucher    PlatformVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@index([voucherId, createdAt])
}

model Booking {
  id                         String                        @id @default(cuid())
  quoteId                    String?                       @unique
  code                       String                        @unique
  userId                     String
  hotelId                    String
  roomId                     String
  hotelNameSnapshot          String
  hotelAddressSnapshot       String
  roomNameSnapshot           String
  roomTypeSnapshot           String
  checkIn                    DateTime                      @db.Date
  checkOut                   DateTime                      @db.Date
  adults                     Int
  children                   Int                           @default(0)
  roomCount                  Int                           @default(1)
  nights                     Int
  pricePerNight              Decimal                       @db.Decimal(14, 2)
  totalAmount                Decimal                       @db.Decimal(14, 2)
  voucherSnapshot            Json?
  nightlyRatesSnapshot       Json?
  cancellationPolicySnapshot String?
  refundRulesSnapshot        Json?
  checkInTimeSnapshot         String?
  checkOutTimeSnapshot        String?
  currency                   String                        @default("VND")
  status                     BookingStatus                 @default(PENDING_PAYMENT)
  paymentMethod              BookingPaymentMethod          @default(PAY_AT_HOTEL)
  paymentDeadline            DateTime?
  guestName                  String
  guestEmail                 String
  guestPhone                 String?
  note                       String?
  ownerInternalNote          String?                       @db.VarChar(1000)
  ownerNoteUpdatedAt         DateTime?
  ownerNoteUpdatedBy         String?
  cancellationReason         String?                       @db.VarChar(500)
  cancellationFee            Decimal?                      @db.Decimal(14, 2)
  refundEstimate             Decimal?                      @db.Decimal(14, 2)
  cancelledAt                DateTime?
  actualCheckInAt            DateTime?
  actualCheckOutAt           DateTime?
  checkedInById              String?
  checkedOutById             String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  user                       User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  hotel                      Hotel                         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room                       Room                          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  operationalTasks           HotelBookingOperationalTask[]
  payments                   Payment[]
  invoices                   Invoice[]
  refundRequests             RefundRequest[]
  stayTransitions            BookingStayTransition[]
  voucherRedemption          VoucherRedemption?
  hotelReport                HotelReport?
  stayReminders              StayReminder[]

  @@index([userId, status, createdAt])
  @@index([hotelId, status, checkIn])
  @@index([hotelId, createdAt, id])
  @@index([roomId, checkIn, checkOut, status])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([checkIn, createdAt, id])
  @@index([checkOut, createdAt, id])
}

model StayReminder {
  id          String           @id @default(cuid())
  bookingId   String
  userId      String
  kind        StayReminderKind
  scheduledAt DateTime
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@index([userId, scheduledAt])
  @@index([sentAt, scheduledAt])
}

model BookingStayTransition {
  id                 String        @id @default(cuid())
  bookingId          String
  hotelId            String
  actorId            String
  action             String        @db.VarChar(16)
  previousStatus     BookingStatus
  newStatus          BookingStatus
  verificationMethod String        @db.VarChar(16)
  idempotencyKey     String        @db.VarChar(120)
  happenedAt         DateTime
  eventType          String        @db.VarChar(40)
  correlationId      String        @db.VarChar(120)
  createdAt          DateTime      @default(now())
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor              User          @relation("StayTransitionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([bookingId, action])
  @@unique([actorId, idempotencyKey])
  @@index([hotelId, createdAt])
  @@index([eventType, createdAt])
}

model HotelReport {
  id           String            @id @default(cuid())
  bookingId    String            @unique
  hotelId      String
  reporterId   String
  reason       HotelReportReason
  description  String            @db.VarChar(1000)
  evidenceUrls String[]          @default([])
  status       HotelReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  hotel        Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reporter     User              @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([hotelId, createdAt])
  @@index([reporterId, createdAt])
}

model Payment {
  id                     String                      @id @default(cuid())
  reference              String?                     @unique
  bookingId              String
  userId                 String?
  provider               String?
  merchantId             String?
  merchantReference      String?                     @unique
  providerTxnId          String?                     @unique
  amount                 Decimal                     @db.Decimal(14, 2)
  currency               String                      @default("VND")
  method                 PaymentMethod?
  status                 PaymentStatus               @default(PENDING)
  idempotencyKey         String?                     @unique
  paidAt                 DateTime?
  cancelledAt            DateTime?
  failureReason          String?
  reconciliationRequired Boolean                     @default(false)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  succeededAt            DateTime?
  failedAt               DateTime?
  booking                Booking                     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user                   User?                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  receipts               PaymentWebhookReceipt[]
  reconciliationCases    PaymentReconciliationCase[]
  outboxEvents           PaymentOutboxEvent[]
  invoices               Invoice[]
  refundRequests         RefundRequest[]

  @@unique([bookingId, method])
  @@index([bookingId, status])
  @@index([bookingId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt, id])
}

model RefundRequest {
  id                String              @id @default(cuid())
  bookingId         String
  paymentId         String
  requesterId       String
  reviewerId        String?
  eventKey          String
  idempotencyKey    String              @unique
  provider          String
  providerRefundRef String?
  amount            Decimal?            @db.Decimal(14, 2)
  currency          String
  reason            String              @db.VarChar(500)
  calculationBasis  Json
  status            RefundRequestStatus @default(PENDING_REVIEW)
  reviewReason      String?             @db.VarChar(500)
  reviewedAt        DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureCode       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  booking           Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment           Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requester         User                @relation("RefundRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer          User?               @relation("RefundReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  events            RefundEvent[]

  @@unique([bookingId, eventKey])
  @@unique([provider, providerRefundRef])
  @@index([paymentId, status, createdAt])
  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt, id])
}

model RefundEvent {
  id              String        @id @default(cuid())
  refundRequestId String
  eventType       String
  actorId         String?
  detail          Json?
  createdAt       DateTime      @default(now())
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)

  @@index([refundRequestId, createdAt])
}

model RefundWebhookReceipt {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  payloadHash String
  outcome     String
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
}

model Invoice {
  id            String              @id @default(cuid())
  invoiceNumber String              @unique
  bookingId     String
  paymentId     String?
  userId        String
  documentType  InvoiceDocumentType
  snapshotHash  String
  snapshot      Json
  issuedAt      DateTime            @default(now())
  createdAt     DateTime            @default(now())
  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bookingId, snapshotHash])
  @@index([userId, issuedAt])
  @@index([paymentId])
}

model PaymentWebhookReceipt {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  paymentId   String?
  payloadHash String
  outcome     String
  createdAt   DateTime @default(now())
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([paymentId, createdAt])
}

model PaymentReconciliationCase {
  id        String   @id @default(cuid())
  paymentId String
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, reason])
  @@index([status, createdAt, id])
}

model PaymentOutboxEvent {
  id          String    @id @default(cuid())
  paymentId   String
  eventType   String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, eventType])
  @@index([processedAt, createdAt])
}

enum RoomPricingRuleKind {
  DATE
  HOLIDAY
  SEASON
  WEEKDAY
  WEEKEND
}

model RoomPricingRule {
  id               String              @id @default(cuid())
  roomId           String
  kind             RoomPricingRuleKind
  label            String?
  startDate        DateTime            @db.Date
  endDateExclusive DateTime            @db.Date
  price            Decimal             @db.Decimal(14, 2)
  active           Boolean             @default(true)
  createdById      String
  updatedById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  room             Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, active, startDate, endDateExclusive])
}

model RoomPricingAudit {
  id        String   @id @default(cuid())
  roomId    String
  actorId   String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt])
}

model RoomInventoryBlock {
  id               String    @id @default(cuid())
  roomId           String
  hotelId          String
  actorId          String
  startDate        DateTime  @db.Date
  endDateExclusive DateTime  @db.Date
  quantity         Int
  reason           String
  active           Boolean   @default(true)
  idempotencyKey   String    @unique
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  releasedAt       DateTime?
  room             Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, active, startDate, endDateExclusive])
}

model RoomInventoryOverride {
  id          String   @id @default(cuid())
  roomId      String
  date        DateTime @db.Date
  sellableQty Int
  updatedAt   DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([roomId, date])
}

model RoomInventoryAudit {
  id             String   @id @default(cuid())
  roomId         String
  hotelId        String
  actorId        String
  action         String
  idempotencyKey String   @unique
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([hotelId, createdAt])
}

model DataSource {
  id            String                     @id @default(cuid())
  key           String                     @unique
  name          String
  publisher     String
  url           String
  version       String
  retrievedAt   DateTime
  effectiveFrom DateTime?
  license       String?
  coverage      String
  checksum      String?
  notes         String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  units         AdministrativeUnit[]
  aliases       AdministrativeUnitAlias[]
  transitions   AdministrativeTransition[]
  streets       Street[]
  importRuns    ImportRun[]
}

model ImportRun {
  id             String          @id @default(cuid())
  sourceId       String
  datasetVersion String
  status         ImportRunStatus @default(RUNNING)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  insertedCount  Int             @default(0)
  updatedCount   Int             @default(0)
  skippedCount   Int             @default(0)
  errorCount     Int             @default(0)
  errorReport    Json?
  source         DataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, datasetVersion])
  @@index([status, startedAt])
}

model AdministrativeUnit {
  id                String                     @id @default(cuid())
  officialCode      String
  name              String
  normalizedName    String
  level             AdministrativeLevel
  unitType          AdministrativeUnitType
  catalogMode       AdministrativeCatalogMode
  status            AdministrativeUnitStatus   @default(ACTIVE)
  parentId          String?
  sourceId          String
  validFrom         DateTime
  validTo           DateTime?
  legalDocument     String?
  metadata          Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  parent            AdministrativeUnit?        @relation("AdministrativeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          AdministrativeUnit[]       @relation("AdministrativeHierarchy")
  source            DataSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  aliases           AdministrativeUnitAlias[]
  transitionsFrom   AdministrativeTransition[] @relation("TransitionFrom")
  transitionsTo     AdministrativeTransition[] @relation("TransitionTo")
  streets           StreetAdministrativeUnit[]
  provinceAddresses SavedAddress[]             @relation("AddressProvince")
  districtAddresses SavedAddress[]             @relation("AddressDistrict")
  communeAddresses  SavedAddress[]             @relation("AddressCommune")

  @@unique([officialCode, catalogMode, validFrom])
  @@index([catalogMode, level, status])
  @@index([parentId, status])
  @@index([normalizedName])
  @@index([officialCode])
}

model AdministrativeUnitAlias {
  id             String                  @id @default(cuid())
  unitId         String
  sourceId       String
  name           String
  normalizedName String
  kind           AdministrativeAliasKind
  createdAt      DateTime                @default(now())
  unit           AdministrativeUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source         DataSource              @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([unitId, normalizedName, kind])
  @@index([normalizedName])
}

model AdministrativeTransition {
  id           String                       @id @default(cuid())
  fromUnitId   String
  toUnitId     String
  sourceId     String
  relationType AdministrativeTransitionType
  confidence   Decimal?                     @db.Decimal(5, 4)
  notes        String?
  createdAt    DateTime                     @default(now())
  fromUnit     AdministrativeUnit           @relation("TransitionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit       AdministrativeUnit           @relation("TransitionTo", fields: [toUnitId], references: [id], onDelete: Restrict)
  source       DataSource                   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([fromUnitId, toUnitId, relationType])
  @@index([fromUnitId])
  @@index([toUnitId])
}

model Street {
  id                  String                     @id @default(cuid())
  officialCode        String?
  name                String
  normalizedName      String
  sourceId            String
  validFrom           DateTime?
  validTo             DateTime?
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  source              DataSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  administrativeUnits StreetAdministrativeUnit[]
  addresses           SavedAddress[]

  @@index([normalizedName])
  @@index([officialCode])
}

model StreetAdministrativeUnit {
  streetId             String
  administrativeUnitId String
  street               Street             @relation(fields: [streetId], references: [id], onDelete: Cascade)
  administrativeUnit   AdministrativeUnit @relation(fields: [administrativeUnitId], references: [id], onDelete: Cascade)

  @@id([streetId, administrativeUnitId])
  @@index([administrativeUnitId])
}

model SavedAddress {
  id                     String              @id @default(cuid())
  ownerId                String
  label                  String?
  mode                   AddressMode
  countryCode            String              @default("VN")
  provinceUnitId         String
  districtUnitId         String?
  communeUnitId          String
  streetId               String?
  streetText             String?
  addressLine            String
  postalCode             String?
  latitude               Decimal?            @db.Decimal(10, 7)
  longitude              Decimal?            @db.Decimal(10, 7)
  formattedAddress       String
  administrativeSnapshot Json
  datasetVersion         String
  isDefault              Boolean             @default(false)
  deletedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  province               AdministrativeUnit  @relation("AddressProvince", fields: [provinceUnitId], references: [id], onDelete: Restrict)
  district               AdministrativeUnit? @relation("AddressDistrict", fields: [districtUnitId], references: [id], onDelete: Restrict)
  commune                AdministrativeUnit  @relation("AddressCommune", fields: [communeUnitId], references: [id], onDelete: Restrict)
  street                 Street?             @relation(fields: [streetId], references: [id], onDelete: SetNull)

  @@index([ownerId, deletedAt])
  @@index([ownerId, isDefault, deletedAt])
  @@index([provinceUnitId])
  @@index([districtUnitId])
  @@index([communeUnitId])
}
