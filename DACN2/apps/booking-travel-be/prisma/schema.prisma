generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdministrativeLevel {
  COUNTRY
  PROVINCE
  DISTRICT
  COMMUNE
}

enum AdministrativeCatalogMode {
  CURRENT
  LEGACY
}

enum AdministrativeUnitStatus {
  ACTIVE
  INACTIVE
  MERGED
  DISSOLVED
}

enum AdministrativeUnitType {
  COUNTRY
  PROVINCE
  MUNICIPALITY
  CITY
  URBAN_DISTRICT
  RURAL_DISTRICT
  TOWN
  WARD
  COMMUNE
  TOWNSHIP
  SPECIAL_ZONE
  UNKNOWN
}

enum AdministrativeAliasKind {
  FORMER_NAME
  ALTERNATIVE_NAME
  SEARCH_NAME
}

enum AdministrativeTransitionType {
  MERGED_INTO
  SPLIT_INTO
  RENAMED_TO
  PARTIALLY_TRANSFERRED_TO
}

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AddressMode {
  CURRENT
  LEGACY
}

enum UserRole {
  USER
  HOTEL_OWNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
}

enum OwnerApplicationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OwnerDocumentPurpose {
  IDENTITY
  BUSINESS_LICENSE
}

enum PrivateMediaStatus {
  RESERVED
  READY
}

enum UserGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AccommodationPreferenceType {
  HOTEL
  RESORT
  VILLA
  APARTMENT
  HOMESTAY
  HOSTEL
}

enum TravelTripType {
  SOLO
  COUPLE
  FAMILY
  FRIENDS
  BUSINESS
  WELLNESS
}

enum TravelAmenityPreference {
  WIFI
  BREAKFAST
  POOL
  PARKING
  SPA
  GYM
  BEACH
  AIRPORT_SHUTTLE
  PET_FRIENDLY
  FAMILY_ROOM
}

enum TravelAreaPreference {
  BEACHFRONT
  CITY_CENTER
  QUIET
  NEAR_AIRPORT
  NEAR_ATTRACTIONS
  NIGHTLIFE
  LOCAL_CULTURE
  NATURE
}

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum HotelStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum HotelSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum HotelMediaStatus {
  RESERVED
  READY
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

model User {
  id                        String                         @id @default(cuid())
  email                     String?                        @unique
  passwordHash              String
  fullName                  String
  phone                     String?                        @unique
  avatarUrl                 String?
  dateOfBirth               DateTime?                      @db.Date
  gender                    UserGender?
  nationality               String?
  address                   String?
  role                      UserRole                       @default(USER)
  status                    UserStatus                     @default(PENDING_VERIFICATION)
  isActive                  Boolean                        @default(false)
  termsAcceptedAt           DateTime?
  emailVerifiedAt           DateTime?
  phoneVerifiedAt           DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  ownedHotels               Hotel[]                        @relation("HotelOwner")
  bookings                  Booking[]
  adminProfile              AdminProfile?
  verificationCodes         VerificationCode[]
  authSessions              AuthSession[]
  adminActions              AdminUserAudit[]               @relation("AdminAuditActor")
  accountAudits             AdminUserAudit[]               @relation("AdminAuditTarget")
  ownerApplication          HotelOwnerApplication?
  privateMedia              PrivateMediaObject[]
  ownerProfile              HotelOwnerProfile?
  ownerReviews              OwnerApplicationAudit[]        @relation("OwnerReviewActor")
  ownerAuditTrail           OwnerApplicationAudit[]        @relation("OwnerReviewApplicant")
  ownerNotifications        OwnerApplicationNotification[]
  reviewedOwnerApplications HotelOwnerApplication[]        @relation("OwnerApplicationReviewer")
  travelPreference          UserPreference?
  hotelRestrictionActions   HotelRestrictionAudit[]        @relation("HotelRestrictionActor")
  hotelRestrictionNotifications HotelRestrictionNotification[] @relation("HotelRestrictionRecipient")
  conversations             Conversation[]                 @relation("ConversationUser")
  ownerConversations        Conversation[]                 @relation("ConversationOwner")
  sentMessages              Message[]

  @@index([role, isActive])
  @@index([status])
}

model HotelOwnerApplication {
  id                         String                         @id @default(cuid())
  userId                     String                         @unique
  status                     OwnerApplicationStatus         @default(DRAFT)
  version                    Int                            @default(1)
  revision                   Int                            @default(0)
  businessName               String?
  businessAddress            String?
  representativeName         String?
  businessRegistrationNumber String?
  businessPhone              String?
  accommodationType          AccommodationPreferenceType?
  hotelDescription           String?
  hotelCoverImageUrl         String?
  identityDocumentId         String?                        @unique
  businessLicenseDocumentId  String?                        @unique
  rejectionReason            String?
  approvalNote               String?
  reviewedAt                 DateTime?
  reviewedById               String?
  reviewHistory              Json                           @default("[]")
  submittedAt                DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  user                       User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityDocument           PrivateMediaObject?            @relation("OwnerIdentity", fields: [identityDocumentId], references: [id], onDelete: SetNull)
  businessLicenseDocument    PrivateMediaObject?            @relation("OwnerLicense", fields: [businessLicenseDocumentId], references: [id], onDelete: SetNull)
  reviewedBy                 User?                          @relation("OwnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  auditTrail                 OwnerApplicationAudit[]
  notifications              OwnerApplicationNotification[]

  @@index([status, submittedAt])
}

model HotelOwnerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  isActive   Boolean  @default(true)
  verifiedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model OwnerApplicationAudit {
  id            String                 @id @default(cuid())
  applicationId String
  applicantId   String
  actorId       String
  action        String
  oldStatus     OwnerApplicationStatus
  newStatus     OwnerApplicationStatus
  reason        String?                @db.VarChar(500)
  version       Int
  createdAt     DateTime               @default(now())
  application   HotelOwnerApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicant     User                   @relation("OwnerReviewApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  actor         User                   @relation("OwnerReviewActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
}

model OwnerApplicationNotification {
  id            String                @id @default(cuid())
  applicationId String
  userId        String
  version       Int
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime              @default(now())
  application   HotelOwnerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([applicationId, version])
  @@index([userId, createdAt])
}

model PrivateMediaObject {
  id                  String                 @id @default(cuid())
  userId              String
  purpose             OwnerDocumentPurpose
  status              PrivateMediaStatus     @default(RESERVED)
  objectKey           String                 @unique
  mimeType            String
  expectedSize        Int
  verifiedAt          DateTime?
  createdAt           DateTime               @default(now())
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityApplication HotelOwnerApplication? @relation("OwnerIdentity")
  licenseApplication  HotelOwnerApplication? @relation("OwnerLicense")

  @@index([userId, purpose, status])
}

model UserPreference {
  id                 String                        @id @default(cuid())
  userId             String                        @unique
  budgetMin          Int?
  budgetMax          Int?
  currency           String                        @default("VND")
  accommodationTypes AccommodationPreferenceType[] @default([])
  tripTypes          TravelTripType[]              @default([])
  preferredAmenities TravelAmenityPreference[]     @default([])
  preferredAreas     TravelAreaPreference[]        @default([])
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AuthSession {
  id               String    @id
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model AdminUserAudit {
  id           String     @id @default(cuid())
  actorId      String
  targetUserId String
  action       String
  oldStatus    UserStatus
  newStatus    UserStatus
  reason       String     @db.VarChar(500)
  createdAt    DateTime   @default(now())
  actor        User       @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target       User       @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

model VerificationCode {
  id                String                     @id @default(cuid())
  userId            String
  sessionId         String                     @unique
  purpose           VerificationPurpose
  channel           VerificationChannel
  target            String
  codeHash          String
  expiresAt         DateTime
  resendAvailableAt DateTime
  sendCount         Int                        @default(1)
  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  deliveryStatus    VerificationDeliveryStatus @default(QUEUED)
  consumedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([target, purpose, expiresAt])
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Hotel {
  id            String      @id @default(cuid())
  ownerId       String
  name          String
  slug          String      @unique
  description   String?
  addressLine   String?
  city          String?
  province      String?
  district      String?
  ward          String?
  provinceUnitId String?
  districtUnitId String?
  wardUnitId    String?
  accommodationType AccommodationPreferenceType?
  contactEmail  String?
  contactPhone  String?
  checkInTime   String?     @db.VarChar(5)
  checkOutTime  String?     @db.VarChar(5)
  profileVersion Int        @default(1)
  restrictionVersion Int    @default(0)
  clientDraftId String?
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  location      Unsupported("geography(Point,4326)")?
  starRating    Int         @default(0)
  status        HotelStatus @default(DRAFT)
  isVisible     Boolean     @default(true)
  amenities     String[]    @default([])
  coverImageUrl String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  owner         User        @relation("HotelOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  rooms         Room[]
  bookings      Booking[]
  policy        HotelPolicy?
  media         HotelMedia[]
  amenityLinks  HotelAmenity[]
  submissions   HotelSubmission[]
  restrictionAudits HotelRestrictionAudit[]
  operationalTasks HotelBookingOperationalTask[]
  conversations Conversation[]

  @@index([ownerId, deletedAt])
  @@index([status, city, deletedAt])
  @@unique([ownerId, clientDraftId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  ownerId   String
  hotelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("ConversationUser", fields: [userId], references: [id], onDelete: Restrict)
  owner     User     @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  messages  Message[]

  @@unique([userId, hotelId])
  @@index([ownerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.VarChar(2000)
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model HotelMedia {
  id           String           @id @default(cuid())
  hotelId      String
  roomId       String?
  ownerId      String
  objectKey    String           @unique
  mimeType     String
  expectedSize Int
  status       HotelMediaStatus @default(RESERVED)
  sortOrder    Int              @default(0)
  isCover      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  verifiedAt   DateTime?
  deletedAt    DateTime?
  hotel        Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room         Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([hotelId, status, sortOrder])
  @@index([roomId, status, sortOrder])
  @@index([ownerId, createdAt])
}

model AmenityCatalog {
  id      String         @id
  name    String
  active  Boolean        @default(true)
  hotels  HotelAmenity[]
}

model HotelAmenity {
  hotelId   String
  amenityId String
  hotel     Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   AmenityCatalog @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([hotelId, amenityId])
}

model HotelSubmission {
  id          String   @id @default(cuid())
  hotelId     String
  ownerId     String
  version     Int
  snapshot    Json
  status      HotelSubmissionStatus @default(PENDING)
  reason      String? @db.VarChar(1000)
  decidedById String?
  decidedAt   DateTime?
  submittedAt DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  audits      HotelSubmissionAudit[]
  notifications HotelSubmissionNotification[]

  @@unique([hotelId, version])
  @@index([ownerId, submittedAt])
}

model HotelSubmissionAudit {
  id           String @id @default(cuid())
  submissionId String
  actorId      String
  action       String
  oldStatus    HotelStatus?
  newStatus    HotelStatus?
  hotelId      String
  version      Int
  reason       String? @db.VarChar(1000)
  requestId    String? @unique @db.VarChar(80)
  createdAt    DateTime @default(now())
  submission   HotelSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt])
}

model HotelSubmissionNotification {
  id           String @id @default(cuid())
  submissionId String
  recipientId  String
  kind         String
  title        String
  body         String
  readAt       DateTime?
  createdAt    DateTime @default(now())
  submission   HotelSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, recipientId, kind])
  @@index([recipientId, createdAt])
}

model HotelRestrictionAudit {
  id                 String   @id @default(cuid())
  hotelId            String
  ownerId            String
  actorId            String
  actorRole           UserRole
  action             String
  beforeStatus       HotelStatus
  afterStatus        HotelStatus
  beforeVisible      Boolean
  afterVisible       Boolean
  profileVersion     Int
  restrictionVersion Int
  reason             String   @db.VarChar(1000)
  evidenceReference  String?  @db.VarChar(500)
  futureBookingCount Int      @default(0)
  requestId          String   @unique @db.VarChar(80)
  createdAt          DateTime @default(now())
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  actor              User     @relation("HotelRestrictionActor", fields: [actorId], references: [id], onDelete: Restrict)
  notifications      HotelRestrictionNotification[]
  operationalTasks   HotelBookingOperationalTask[]

  @@index([hotelId, createdAt])
}

model HotelRestrictionNotification {
  id         String   @id @default(cuid())
  decisionId String
  recipientId String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())
  decision   HotelRestrictionAudit @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  recipient  User     @relation("HotelRestrictionRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([decisionId, recipientId])
  @@index([recipientId, createdAt])
}

model HotelBookingOperationalTask {
  id         String   @id @default(cuid())
  decisionId String
  hotelId    String
  bookingId  String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  decision   HotelRestrictionAudit @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([decisionId, bookingId])
  @@index([hotelId, status, createdAt])
}

model HotelPolicy {
  hotelId            String   @id
  cancellationPolicy String?
  houseRules         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Room {
  id               String     @id @default(cuid())
  hotelId          String
  name             String
  type             String
  description      String?
  capacityAdults   Int        @default(2)
  capacityChildren Int        @default(0)
  bedInfo          String
  classCode        String?
  viewCode         String?
  bedConfigurations Json?
  areaM2           Decimal?   @db.Decimal(7, 2)
  quantity         Int        @default(1)
  basePrice        Decimal    @db.Decimal(14, 2)
  currency         String     @default("VND")
  status           RoomStatus @default(ACTIVE)
  revision         Int        @default(1)
  amenities        String[]   @default([])
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  hotel            Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  media            HotelMedia[]
  bookings         Booking[]
  inventoryBlocks  RoomInventoryBlock[]
  inventoryOverrides RoomInventoryOverride[]
  inventoryAudits  RoomInventoryAudit[]

  @@index([hotelId, status, deletedAt])
}

model Booking {
  id            String        @id @default(cuid())
  code          String        @unique
  userId        String
  hotelId       String
  roomId        String
  roomNameSnapshot String
  roomTypeSnapshot String
  checkIn       DateTime      @db.Date
  checkOut      DateTime      @db.Date
  adults        Int
  children      Int           @default(0)
  roomCount     Int           @default(1)
  nights        Int
  pricePerNight Decimal       @db.Decimal(14, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  currency      String        @default("VND")
  status        BookingStatus @default(PENDING_PAYMENT)
  guestName     String
  guestEmail    String
  guestPhone    String?
  note          String?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  operationalTasks HotelBookingOperationalTask[]

  @@index([userId, status, createdAt])
  @@index([hotelId, status, checkIn])
  @@index([roomId, checkIn, checkOut, status])
}

model RoomInventoryBlock {
  id               String   @id @default(cuid())
  roomId           String
  hotelId          String
  actorId          String
  startDate        DateTime @db.Date
  endDateExclusive DateTime @db.Date
  quantity         Int
  reason           String
  active           Boolean  @default(true)
  idempotencyKey   String   @unique
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  releasedAt       DateTime?
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([roomId, active, startDate, endDateExclusive])
}

model RoomInventoryOverride {
  id          String   @id @default(cuid())
  roomId      String
  date        DateTime @db.Date
  sellableQty Int
  updatedAt   DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([roomId, date])
}

model RoomInventoryAudit {
  id             String   @id @default(cuid())
  roomId         String
  hotelId        String
  actorId        String
  action         String
  idempotencyKey String   @unique
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([hotelId, createdAt])
}

model DataSource {
  id            String                     @id @default(cuid())
  key           String                     @unique
  name          String
  publisher     String
  url           String
  version       String
  retrievedAt   DateTime
  effectiveFrom DateTime?
  license       String?
  coverage      String
  checksum      String?
  notes         String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  units         AdministrativeUnit[]
  aliases       AdministrativeUnitAlias[]
  transitions   AdministrativeTransition[]
  streets       Street[]
  importRuns    ImportRun[]
}

model ImportRun {
  id             String          @id @default(cuid())
  sourceId       String
  datasetVersion String
  status         ImportRunStatus @default(RUNNING)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  insertedCount  Int             @default(0)
  updatedCount   Int             @default(0)
  skippedCount   Int             @default(0)
  errorCount     Int             @default(0)
  errorReport    Json?
  source         DataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, datasetVersion])
  @@index([status, startedAt])
}

model AdministrativeUnit {
  id                String                     @id @default(cuid())
  officialCode      String
  name              String
  normalizedName    String
  level             AdministrativeLevel
  unitType          AdministrativeUnitType
  catalogMode       AdministrativeCatalogMode
  status            AdministrativeUnitStatus   @default(ACTIVE)
  parentId          String?
  sourceId          String
  validFrom         DateTime
  validTo           DateTime?
  legalDocument     String?
  metadata          Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  parent            AdministrativeUnit?        @relation("AdministrativeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          AdministrativeUnit[]       @relation("AdministrativeHierarchy")
  source            DataSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  aliases           AdministrativeUnitAlias[]
  transitionsFrom   AdministrativeTransition[] @relation("TransitionFrom")
  transitionsTo     AdministrativeTransition[] @relation("TransitionTo")
  streets           StreetAdministrativeUnit[]
  provinceAddresses SavedAddress[]             @relation("AddressProvince")
  districtAddresses SavedAddress[]             @relation("AddressDistrict")
  communeAddresses  SavedAddress[]             @relation("AddressCommune")

  @@unique([officialCode, catalogMode, validFrom])
  @@index([catalogMode, level, status])
  @@index([parentId, status])
  @@index([normalizedName])
  @@index([officialCode])
}

model AdministrativeUnitAlias {
  id             String                  @id @default(cuid())
  unitId         String
  sourceId       String
  name           String
  normalizedName String
  kind           AdministrativeAliasKind
  createdAt      DateTime                @default(now())
  unit           AdministrativeUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source         DataSource              @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([unitId, normalizedName, kind])
  @@index([normalizedName])
}

model AdministrativeTransition {
  id           String                       @id @default(cuid())
  fromUnitId   String
  toUnitId     String
  sourceId     String
  relationType AdministrativeTransitionType
  confidence   Decimal?                     @db.Decimal(5, 4)
  notes        String?
  createdAt    DateTime                     @default(now())
  fromUnit     AdministrativeUnit           @relation("TransitionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit       AdministrativeUnit           @relation("TransitionTo", fields: [toUnitId], references: [id], onDelete: Restrict)
  source       DataSource                   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([fromUnitId, toUnitId, relationType])
  @@index([fromUnitId])
  @@index([toUnitId])
}

model Street {
  id                  String                     @id @default(cuid())
  officialCode        String?
  name                String
  normalizedName      String
  sourceId            String
  validFrom           DateTime?
  validTo             DateTime?
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  source              DataSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  administrativeUnits StreetAdministrativeUnit[]
  addresses           SavedAddress[]

  @@index([normalizedName])
  @@index([officialCode])
}

model StreetAdministrativeUnit {
  streetId             String
  administrativeUnitId String
  street               Street             @relation(fields: [streetId], references: [id], onDelete: Cascade)
  administrativeUnit   AdministrativeUnit @relation(fields: [administrativeUnitId], references: [id], onDelete: Cascade)

  @@id([streetId, administrativeUnitId])
  @@index([administrativeUnitId])
}

model SavedAddress {
  id                     String              @id @default(cuid())
  ownerId                String
  label                  String?
  mode                   AddressMode
  countryCode            String              @default("VN")
  provinceUnitId         String
  districtUnitId         String?
  communeUnitId          String
  streetId               String?
  streetText             String?
  addressLine            String
  postalCode             String?
  latitude               Decimal?            @db.Decimal(10, 7)
  longitude              Decimal?            @db.Decimal(10, 7)
  formattedAddress       String
  administrativeSnapshot Json
  datasetVersion         String
  isDefault              Boolean             @default(false)
  deletedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  province               AdministrativeUnit  @relation("AddressProvince", fields: [provinceUnitId], references: [id], onDelete: Restrict)
  district               AdministrativeUnit? @relation("AddressDistrict", fields: [districtUnitId], references: [id], onDelete: Restrict)
  commune                AdministrativeUnit  @relation("AddressCommune", fields: [communeUnitId], references: [id], onDelete: Restrict)
  street                 Street?             @relation(fields: [streetId], references: [id], onDelete: SetNull)

  @@index([ownerId, deletedAt])
  @@index([ownerId, isDefault, deletedAt])
  @@index([provinceUnitId])
  @@index([districtUnitId])
  @@index([communeUnitId])
}
